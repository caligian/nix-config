#!/usr/bin/env python

import os
import re
import sys
from glob import glob
from subprocess import check_output


def count_lines(file: str) -> int:
    with open(file, "r", errors="ignore", encoding="utf-8") as fh:
        return sum(1 for _ in fh.readlines())


def is_valid_file(file: str) -> bool:
    return (
        len(file) > 0
        and os.path.isfile(file)
        and not re.search("[.](png|jpg|jpeg)$", file)
    )


def git_ls_files() -> list[str]:
    files = check_output(["git", "ls-files"]).decode().split("\n")
    files = list(filter(is_valid_file, files))
    return files


fs = sorted(git_ls_files())
lcs = list(map(count_lines, fs))
lcs = list(zip(fs, lcs))
lcs = sorted(lcs, key=lambda x: x[1])

for file, lc in lcs:
    print(f"{lc:<5} {file}")

print(f"Total: {sum([x[1] for x in lcs])}")
